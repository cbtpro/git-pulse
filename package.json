{
  "name": "gitpulse-monorepo",
  "version": "0.0.1",
  "description": "GitPulse - 跨平台 GitHub 管理工具 (Monorepo 版本)",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/app"
  ],
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:app": "pnpm dev:desktop",
    "build": "pnpm build:desktop",
    "build:app": "pnpm build:desktop",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "clean": "node scripts/dev/clean.mjs",
    "install-all": "pnpm install --frozen-lockfile",
    "dev:web": "node scripts/dev/frontend.mjs",
    "dev:desktop": "node scripts/dev/platform.mjs dev desktop",
    "build:web": "pnpm -F @gitpulse/app build:web",
    "build:desktop": "node scripts/dev/platform.mjs build desktop",
    "doctor": "node scripts/dev/doctor.mjs",
    "test:scripts": "node --test scripts/ci/scripts.test.mjs scripts/dev/*.test.mjs",
    "icons:generate": "node scripts/dev/icons.mjs",
    "icons:sync": "node scripts/dev/sync-icons.mjs",
    "check": "pnpm type-check && pnpm lint && pnpm test && pnpm test:scripts",
    "preview:web": "pnpm -F @gitpulse/app preview",
    "dev:macos": "node scripts/dev/platform.mjs dev macos",
    "build:macos": "node scripts/dev/platform.mjs build macos",
    "dev:windows": "node scripts/dev/platform.mjs dev windows",
    "build:windows": "node scripts/dev/platform.mjs build windows",
    "dev:linux": "node scripts/dev/platform.mjs dev linux",
    "build:linux": "node scripts/dev/platform.mjs build linux",
    "dev:ios": "node scripts/dev/platform.mjs dev ios",
    "build:ios": "node scripts/dev/platform.mjs build ios",
    "dev:android": "node scripts/dev/platform.mjs dev android",
    "build:android": "node scripts/dev/platform.mjs build android",
    "init:ios": "node scripts/dev/platform.mjs init ios",
    "init:android": "node scripts/dev/platform.mjs init android",
    "build:ios:simulator": "node scripts/dev/platform.mjs build ios:simulator",
    "test:workspace:browser": "node scripts/qa/workspace.mjs",
    "test:mobile:viewport": "node scripts/qa/mobile-viewport.mjs",
    "test:auth:recovery": "node scripts/qa/auth-recovery.mjs",
    "test:page-state": "node scripts/qa/page-state.mjs",
    "test:navigation": "node scripts/qa/navigation.mjs",
    "test:interactive-back": "node scripts/qa/interactive-back.mjs",
    "test:ios:navigation": "node scripts/qa/ios-navigation.mjs",
    "test:startup": "node scripts/qa/startup-profile.mjs",
    "test:vault-concurrency": "node scripts/qa/vault-concurrency.mjs",
    "test:resource-consistency": "node scripts/qa/resource-consistency.mjs",
    "test:safe-area-layout": "node scripts/qa/safe-area-layout.mjs",
    "build:pages": "pnpm -F @gitpulse/app build:pages",
    "preview:pages": "pnpm -F @gitpulse/app preview:pages",
    "test:pages": "node scripts/qa/pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "pnpm": "^10.34.9",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "github",
    "tauri",
    "react",
    "typescript",
    "cross-platform",
    "ios",
    "macos",
    "android"
  ],
  "author": "GitPulse Team",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9"
}
