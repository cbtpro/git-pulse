# Copy to .env.ios.local. This local file is ignored by Git.
# Xcode > Settings > Apple Accounts: use the Team ID, not the certificate's ID.
APPLE_DEVELOPMENT_TEAM=
# Optional device name. Used by dev:ios / tauri:ios when no arguments are given.
GITPULSE_IOS_DEVICE=
# auto: Personal Team device builds omit widgets; simulator builds keep them.
# enabled requires a paid team with App Groups on a physical device.
GITPULSE_IOS_WIDGETS=auto
