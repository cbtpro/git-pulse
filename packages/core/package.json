{
  "name": "@gitpulse/core",
  "version": "0.0.1",
  "description": "GitPulse 核心库 - GitHub API 层和类型定义",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./api": {
      "types": "./src/services/api/index.ts",
      "import": "./src/services/api/index.ts"
    },
    "./types": {
      "types": "./src/types/github.ts",
      "import": "./src/types/github.ts"
    },
    "./auth": {
      "types": "./src/services/auth/TokenManager.ts",
      "import": "./src/services/auth/TokenManager.ts"
    }
  },
  "scripts": {
    "dev": "echo 'Core library in development mode'",
    "build": "echo 'Core library built successfully'",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx"
  },
  "dependencies": {
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "github",
    "api",
    "typescript",
    "types"
  ],
  "author": "GitPulse Team",
  "license": "MIT"
}
