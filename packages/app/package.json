{
  "name": "@gitpulse/app",
  "version": "0.0.1",
  "description": "GitPulse Tauri 应用 - Web、iOS、Android、macOS、Windows、Linux 跨平台应用",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev/platform.mjs dev desktop",
    "vite-dev": "vite",
    "build": "node ../../scripts/dev/platform.mjs build desktop",
    "build:debug": "node ../../scripts/dev/platform.mjs build desktop --debug",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:web": "vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "tauri": "tauri",
    "tauri:ios": "node ../../scripts/dev/platform.mjs dev ios",
    "tauri:ios:build": "node ../../scripts/dev/platform.mjs build ios",
    "tauri:macos": "node ../../scripts/dev/platform.mjs dev macos",
    "tauri:macos:build": "node ../../scripts/dev/platform.mjs build macos",
    "preview": "vite preview",
    "tauri:android": "node ../../scripts/dev/platform.mjs dev android",
    "tauri:android:build": "node ../../scripts/dev/platform.mjs build android",
    "dev:web": "node ../../scripts/dev/frontend.mjs",
    "doctor": "node ../../scripts/dev/doctor.mjs",
    "tauri:windows": "node ../../scripts/dev/platform.mjs dev windows",
    "tauri:windows:build": "node ../../scripts/dev/platform.mjs build windows",
    "tauri:linux": "node ../../scripts/dev/platform.mjs dev linux",
    "tauri:linux:build": "node ../../scripts/dev/platform.mjs build linux",
    "tauri:ios:init": "node ../../scripts/dev/platform.mjs init ios",
    "tauri:android:init": "node ../../scripts/dev/platform.mjs init android",
    "tauri:ios:build:simulator": "node ../../scripts/dev/platform.mjs build ios:simulator",
    "build:pages": "vite build --mode pages",
    "preview:pages": "vite preview --mode pages"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.18",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "axios": "^1.6.2",
    "i18next": "^27.2.2",
    "lucide-react": "^1.76.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^18.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "github",
    "tauri",
    "react",
    "typescript",
    "cross-platform",
    "ios",
    "macos",
    "windows",
    "linux"
  ],
  "author": "GitPulse Team",
  "license": "MIT"
}
